<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DiarioGym.ViewModels"
             x:Class="DiarioGym.Views.RutinasPage"
             x:DataType="vm:RutinasViewModel"
             Title="Rutinas">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <Button Text="+ Nueva rutina" Command="{Binding NuevaCommand}" HeightRequest="50" />

            <Border Style="{StaticResource Tarjeta}" IsVisible="{Binding Vacio}">
                <Label Text="Crea tu primera rutina: ponle nombre, elige los días y añade ejercicios con series, repeticiones y peso objetivo."
                       Style="{StaticResource Apagado}" HorizontalTextAlignment="Center" />
            </Border>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="14">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:RutinaItem">
                        <Border Style="{StaticResource Tarjeta}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Nombre}" FontSize="18" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding DiasTexto}" Style="{StaticResource Apagado}" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding EjerciciosTexto}" LineHeight="1.3" />
                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="Editar" Style="{StaticResource Fantasma}" Command="{Binding EditarCommand}" />
                                    <Button Text="Eliminar" Style="{StaticResource Fantasma}" Command="{Binding EliminarCommand}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
