<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Fondo}, Dark={StaticResource FondoOscuro}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource Fondo}, Dark={StaticResource FondoOscuro}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource Tinta}, Dark={StaticResource TintaOscuro}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource Tinta}, Dark={StaticResource TintaOscuro}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieOscuro}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource Acento}, Dark={StaticResource AcentoOscuro}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource Acento}, Dark={StaticResource AcentoOscuro}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource Apagado}, Dark={StaticResource ApagadoOscuro}}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Tinta}, Dark={StaticResource TintaOscuro}}" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="Etiqueta" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Apagado}, Dark={StaticResource ApagadoOscuro}}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.2" />
    </Style>
    <Style x:Key="Apagado" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Apagado}, Dark={StaticResource ApagadoOscuro}}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="Titular" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Tinta}, Dark={StaticResource TintaOscuro}}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>
    <Style x:Key="Seccion" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Tinta}, Dark={StaticResource TintaOscuro}}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>
    <Style x:Key="Numero" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Tinta}, Dark={StaticResource TintaOscuro}}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieOscuro}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Linea}, Dark={StaticResource LineaOscuro}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AcentoSuave}, Dark={StaticResource AcentoSuaveOscuro}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="HeightRequest" Value="32" />
    </Style>
    <Style x:Key="Separador" TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Linea}, Dark={StaticResource LineaOscuro}}" />
        <Setter Property="HeightRequest" Value="1" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Acento}, Dark={StaticResource AcentoOscuro}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AcentoTexto}, Dark={StaticResource AcentoTextoOscuro}}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style x:Key="Fantasma" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Tinta}, Dark={StaticResource TintaOscuro}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Linea}, Dark={StaticResource LineaOscuro}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style x:Key="Enlace" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Acento}, Dark={StaticResource AcentoOscuro}}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="ChipBorrar" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Apagado}, Dark={StaticResource ApagadoOscuro}}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="32" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="MinimumHeightRequest" Value="32" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Tinta}, Dark={StaticResource TintaOscuro}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Apagado}, Dark={StaticResource ApagadoOscuro}}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>
    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Tinta}, Dark={StaticResource TintaOscuro}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource Apagado}, Dark={StaticResource ApagadoOscuro}}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Tinta}, Dark={StaticResource TintaOscuro}}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource Acento}, Dark={StaticResource AcentoOscuro}}" />
    </Style>
</ResourceDictionary>
